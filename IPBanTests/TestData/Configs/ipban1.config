<?xml version="1.0"?>

<configuration>

	<!--
		Please see full configuration documentation:
		- https://github.com/DigitalRuby/IPBan/wiki/Configuration
		- https://github.com/DigitalRuby/IPBan/wiki/Regex
    -->

	<!-- 파싱(분석)할 로그 파일들의 목록입니다. 각 로그 파일은 PingInterval 설정 간격에 따라 주기적으로 상태를 확인(폴링)합니다. -->
	<LogFilesToParse>
		<LogFiles>

			<!-- Apache (Linux and Windows) -->
			<LogFile>

				<Source>Apache</Source>
				<PathAndMask>
					C:/Program Files/Tomcat/logs/**/*access_log*.txt
				</PathAndMask>
				<FailedLoginRegex>
					<![CDATA[
						^(?<ipaddress>[^\s]+)\s.*?\[(?<timestamp>.*?)\].*?(?:\s(?<log>40[03])\s(-|[0-9]+)|((php|md5sum|cgi-bin|joomla).*?\s(?<log>40[03]\s[0-9]+|\s400\s-)))[^\n]*
					]]>
				</FailedLoginRegex>
				<FailedLoginRegexTimestampFormat>dd/MMM/yyyy:HH:mm:ss zzzz</FailedLoginRegexTimestampFormat>
				<PlatformRegex>Windows|Linux</PlatformRegex>
				<PingInterval>10000</PingInterval>
				<MaxFileSize>16777216</MaxFileSize>
				<FailedLoginThreshold>0</FailedLoginThreshold>

			</LogFile>

		</LogFiles>
	</LogFilesToParse>

	<!--
		*윈도우 전용* 
		윈도우 이벤트 뷰어를 통해 차단 대상을 감지할 표현식(Expression) 설정입니다.
		각 설정 항목은 <Group> 태그 내에 포함되어야 합니다.
		검색할 키워드를 지정할 수 있습니다 (AND 조건 적용).
		각 그룹에는 XPath와 Regex(정규식)가 포함되며, 정규식 검사를 하지 않을 경우 정규식 항목은 비워둘 수 있습니다.
		텍스트 양 끝의 공백은 내부적으로 제거되므로, 정규식 작성 시 앞뒤 공백 지정 시에는 \s를 사용하는 것이 권장됩니다.
		이벤트가 필터링되려면 모든 조건이 일치해야 하며, 차단할 IP 주소를 추출하기 위해 최소 하나의 정규식에는 ipaddress 캡처 그룹이 지정되어 있어야 합니다.
		정규식 그룹 내 IP 추출 시 ipaddress(IP 또는 DNS 대조용) 또는 ipaddress_exact(정확한 IP 대조 전용) 키워드를 사용하세요.
	-->
	<ExpressionsToBlock>
		<Groups>

			<!-- 이 그룹은 로그인 실패(감사 실패 로그)가 발생했을 때 해당 IP를 차단합니다. -->
			<Group>
				<Source>RDP</Source>
				<Keywords>0x8010000000000000</Keywords>
				<Path>Security</Path>

				<!-- 차단 기준이 될 로그인 실패 횟수를 개별 재정의합니다. (0으로 두면 기본 설정값 사용) -->
				<FailedLoginThreshold>0</FailedLoginThreshold>

				<!-- (선택 사항) 로그인 시도 간의 최소 시간 간격을 재정의합니다.
					<MinimumTimeBetweenLoginAttempts>00:00:00:01</MinimumTimeBetweenLoginAttempts>
				-->

				<!-- (선택 사항) 로그 레벨을 설정합니다. 아래 항목 중 하나와 정확히 일치해야 합니다 (대소문자 구분):
					Trace, Debug, Info, Warn, Error, Critical
					<LogLevel>Warn</LogLevel>		
				-->

				<Expressions>
					<Expression>
						<XPath>//EventID</XPath>
						<Regex>
							<![CDATA[
								^(?<log>4625|6273)$
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>//Data[@Name='IpAddress' or @Name='Workstation' or @Name='SourceAddress' or @Name='ClientIPAddress']</XPath>
						<Regex>
							<![CDATA[
								(?<ipaddress>.+)
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>//Data[@Name='ProcessName']</XPath>
						<Regex>
							<![CDATA[
								(?<source_IIS>c:\\Windows\\System32\\inetsrv\\w3wp.exe)?$
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!-- 이 그룹은 NTLM이 비활성화된 Windows Server 2008 환경에서 발생한 로그인 실패 로그를 감지하여 해당 IP를 차단합니다. -->
			<Group>
				<Source>RDP</Source>
				<Keywords>0x8010000000000000</Keywords>
				<Path>Security</Path>
				<FailedLoginThreshold>0</FailedLoginThreshold>
				<Expressions>
					<Expression>
						<XPath>//EventID</XPath>
						<Regex>
							<![CDATA[
								^(?<log>4653)$
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>//Data[@Name='FailureReason']</XPath>
						<Regex>.</Regex>
					</Expression>
					<Expression>
						<XPath>//Data[@Name='RemoteAddress']</XPath>
						<Regex>
							<![CDATA[
								(?<ipaddress>.+)
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!-- 이 그룹은 Windows 환경에서 사용자가 플러그인을 통해 직접 정의한 커스텀 IPBan 로그인 실패 이벤트를 감지하여 차단합니다. (자세한 내용은 IPBanPlugin.cs 참고) -->
			<Group>
				<Source>IPBanCustom</Source>
				<Keywords>0x80000000000000</Keywords>
				<Path>Application</Path>
				<FailedLoginThreshold>0</FailedLoginThreshold>
				<Expressions>
					<Expression>
						<XPath>//Data</XPath>
						<Regex>
							<![CDATA[
								(?<timestamp>\d\d\d\d-\d\d-\d\d\s\d\d:\d\d:\d\d(?:\.\d+)?Z?)?(?:,\s)?(?<log>ipban\sfailed\slogin),\sip\saddress:\s(?<ipaddress>[^,]+),\ssource:\s(?<source>[^,]+)?,\suser:\s(?<username>[^\s,]+)?
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!-- 이 그룹은 Microsoft SQL Server에 발생한 로그인 실패(감사 실패) 로그를 감지하여 해당 IP를 차단합니다. -->
			<!--
				<EventData>
					<Data>username</Data> 
					<Data>Reason: Could not find a login matching the name provided.</Data> 
					<Data>[CLIENT: 192.168.1.99]</Data> 
					<Binary>184800000E000000090000004E0053003500320034003400300036000000070000006D00610073007400650072000000</Binary> 
				</EventData>
			-->
			<Group>
				<Source>MSSQL</Source>
				<Keywords>0x90000000000000</Keywords>
				<Path>Application</Path>
				<FailedLoginThreshold>0</FailedLoginThreshold>
				<Expressions>
					<Expression>
						<XPath>//Provider[contains(@Name,'MSSQL')]</XPath>
						<Regex></Regex>
					</Expression>
					<Expression>
						<XPath>//EventID</XPath>
						<Regex>
							<![CDATA[
								^(?<log>18456)$
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>(//Data)[1]</XPath>
						<Regex>
							<![CDATA[
								^(?<username>.+)$
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>(//Data)[2]</XPath>
						<!--			
							감지 및 차단 대상 로그 예시:
							비밀번호 검증 오류, 계정명 불일치, 연결 복구 중 DB 열기 실패 등 실제 공격이나 비밀번호 오류로 인한 로그인 실패 로그들입니다.
							(스페인어 등 다국어 MSSQL 환경의 로그인 실패 메시지도 포함되어 있습니다.)
							-Reason: An error occurred while evaluating the password
							-Login failed for user 'username'. Reason: Failed to open the database 'db' configured in the session recovery object while recovering the connection. [CLIENT: 1.1.1.1]
							-Login failed for user 'NT AUTHORITY\ANONYMOUS LOGON'. Reason: Could not find a login matching the name provided. [CLIENT: 1.1.1.1]
							-Motivo: no se encontró un inicio de sesión que coincida con el nombre proporcionado.

							무시 및 예외 처리 대상 로그 예시:
							계정/비밀번호는 맞았으나, 단지 지정한 데이터베이스 접근 권한이 없어서 발생한 접속 실패인 경우입니다. 
							이는 비밀번호 무차별 대입 공격이 아니므로 억울하게 IP가 차단되는 것을 막기 위해 감지 대상에서 제외합니다. [CLIENT: 1.1.1.1]
						-->
						<!--
							[수정 사항]
							1. (?<reason>...) 캡처 그룹을 추가하여 로그의 reason 부분 추출
							2. 영문(Reason:) 및 한글(원인:) 로그인 실패 사유 모두 대응
							3. DB 접근 권한 오류(Failed to open database) 무시 필터 유지
						-->
						<Regex>
							<![CDATA[
								^(?:(?!Reason:\sFailed\sto\sopen|원인:\s.*데이터베이스를\s열지\s못했습니다).)*(?:Reason|원인):\s*(?<reason>[^\.\[\r\n]+)
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>(//Data)[3]</XPath>
						<Regex>
							<![CDATA[
								\[(CLIENTE?|클라이언트)\s?:\s?(?<ipaddress>[^\]]+)\]
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!-- This group will block audit failures from failed login attempts to MySQL & MariaDB Server -->
			<Group>
				<Source>MySQL</Source>
				<Keywords>0x80000000000000</Keywords>
				<Path>Application</Path>
				<FailedLoginThreshold>0</FailedLoginThreshold>
				<Expressions>
					<Expression>
						<XPath>//Provider[@Name='MySQL' or @Name='MariaDB']</XPath>
						<Regex></Regex>
					</Expression>
					<Expression>
						<XPath>//Data</XPath>
						<Regex>
							<![CDATA[
								(?<log>Access denied for user) '?(?<username>[^']+)'@'(?<ipaddress>[^']+)'
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!-- This group will block audit failures from failed login attempts to phpMyAdmin Web Interface -->
			<Group>
				<Source>phpMyAdmin</Source>
				<Keywords>0x80000000000000</Keywords>
				<Path>Application</Path>
				<FailedLoginThreshold>0</FailedLoginThreshold>
				<Expressions>
					<Expression>
						<XPath>//Data</XPath>
						<Regex>phpMyAdmin</Regex>
					</Expression>
					<Expression>
						<XPath>//Data</XPath>
						<Regex>
							<![CDATA[
								(?<log>user\sdenied):\s+(?<username>[^\s]+)\s+\(mysql-denied\)\s+from\s+(?<ipaddress>.+)
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!--
				This group will block OpenSSH login failures
			-->
			<Group>
				<Source>SSH</Source>
				<Keywords>0x4000000000000000</Keywords>
				<Path>OpenSSH/Operational</Path>
				<FailedLoginThreshold>0</FailedLoginThreshold>
				<Expressions>
					<Expression>
						<XPath>//Data[@Name='payload']</XPath>
						<Regex>
							<![CDATA[
								(?<log>failed\s+password)\s+for\s+(invalid\s+user\s+)?(?<username>[^\s]+)\s+from\s+(?<ipaddress>[^\s]+)\s+port\s+[0-9]+\s+ssh|
								(?<log>did\s+not\s+receive\s+identification\s+string)\s+from\s+(?<ipaddress>[^\s]+)|
								(?<log>connection\s+(?:closed|reset))\s+by\s+(?:(?:(?:invalid|authenticating)\s+user\s+)?(?<username>[^\s]+)\s+)?(?<ipaddress>[^\s]+)\s+port\s+[0-9]+\s+\[preauth\]|
								(?<log>disconnected\s+from)\s+(invalid\s+user\s+)?(?<username>[^\s]+)\s+(?<ipaddress>[^\s]+)\s+port\s+[0-9]+\s+\[preauth\]|
								(?<log>disconnected\s+from)\s+(?<ipaddress>[^\s]+)\s+port\s+[0-9]+\s+\[preauth\]|
								(?<log>disconnected\s+from\s+authenticating\s+user)\s+(?<username>[^\s]+)\s+(?<ipaddress>[^\s]+)\s+port\s+[0-9]+\s+\[preauth\]
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!-- Alternate openssh failures -->
			<Group>
				<Source>SSH</Source>
				<Keywords>0x80000000000000</Keywords>
				<Path>Application</Path>
				<FailedLoginThreshold>0</FailedLoginThreshold>
				<Expressions>
					<Expression>
						<XPath>//EventID</XPath>
						<Regex>^0$</Regex>
					</Expression>
					<Expression>
						<XPath>//Data</XPath>
						<Regex>
							<![CDATA[
								^sshd:\spid\s[0-9]+:\sinvalid\suser\s(?<username>[^\s]+)\sfrom\s(?<ipaddress>[^\s]+)\sport\s[0-9]+
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!--
				이 그룹은 응용 프로그램 및 서비스 로그 > Microsoft-Windows-RemoteDesktopServices-RdpCoreTS/Operational 로그 경로에 기록되는 NTLM 로그인 실패 이벤트를 감지하여 차단합니다.
				(OpCode 14번 값은 비정상적인/유효하지 않은 프로토콜 접속을 의미하며, 이는 대부분 해커의 공격 징후입니다.)
			-->
			<Group>
				<Source>RDP</Source>
				<Keywords>0x4000000000000000</Keywords>
				<Path>Microsoft-Windows-RemoteDesktopServices-RdpCoreTS/Operational</Path>
				<FailedLoginThreshold>0</FailedLoginThreshold>
				<Expressions>
					<Expression>
						<XPath>//Opcode</XPath>
						<Regex>
							<![CDATA[
								^(?<log>14)$
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>//Data[@Name='ClientIP' or @Name='IPString']</XPath>
						<Regex>
							<![CDATA[
								(?<ipaddress>.+)
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!-- This group will block audit failures from VNC to Windows -->
			<Group>
				<Source>VNC</Source>
				<Keywords>0x80000000000000</Keywords>
				<Path>Application</Path>
				<FailedLoginThreshold>0</FailedLoginThreshold>
				<Expressions>
					<Expression>
						<XPath>//EventID</XPath>
						<Regex>^258$</Regex>
					</Expression>
					<Expression>
						<XPath>//Data</XPath>
						<Regex>
							<![CDATA[
								(?<log>Authentication\sfailed)\sfrom\s(?<ipaddress>.+)
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!-- This group will block RRAS login failures to Windows -->
			<Group>
				<Source>RRAS</Source>
				<Keywords>0x80000000000000</Keywords>
				<Path>System</Path>
				<FailedLoginThreshold>0</FailedLoginThreshold>
				<Expressions>
					<Expression>
						<XPath>//EventID</XPath>
						<Regex>^20271$</Regex>
					</Expression>
					<Expression>
						<XPath>(//Data)[2]</XPath>
						<Regex>
							<![CDATA[
								(?<username>.*)
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>(//Data)[3]</XPath>
						<Regex>
							<![CDATA[
								(?<ipaddress>.+)
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>(//Data)[4]</XPath>
						<Regex>
							<![CDATA[
								(?<log>denied|connection\swas\sprevented|Die\sRemoteverbindung\swurde\sverweigert)
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

		</Groups>
	</ExpressionsToBlock>

	<!--
		*윈도우 전용 / IPBan Pro 유료 버전 전용* 
		윈도우 이벤트 뷰어 기반으로 알림(Notification)을 보낼 표현식 설정입니다.
		ExpressionsToBlock과 작동 방식은 동일하지만, 해당 이벤트가 발생했을 때 이메일 등으로 알림만 전송되고 IP 차단 처리는 수행되지 않는 점이 다릅니다.
		로그인 성공 이력 모니터링 등에 유용하게 활용할 수 있습니다.
	-->
	<ExpressionsToNotify>
		<Groups>

			<!-- Notify of succes RDP events -->
			<Group>
				<Source>RDP</Source>
				<Keywords>0x8020000000000000</Keywords>
				<Path>Security</Path>
				<Expressions>
					<Expression>
						<XPath>//EventID</XPath>
						<Regex>^4624$</Regex>
					</Expression>
					<Expression>
						<XPath>//Data[@Name='ProcessName' or @Name='LogonProcessName']</XPath>
						<Regex>winlogon|svchost|ntlmssp</Regex>
					</Expression>
					<Expression>
						<XPath>//Data[@Name='IpAddress' or @Name='Workstation' or @Name='SourceAddress']</XPath>
						<Regex>
							<![CDATA[
								(?<ipaddress>.+)
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>
			<Group>
				<Source>RDP</Source>
				<Keywords>0x1000000000000000</Keywords>
				<Path>Microsoft-Windows-TerminalServices-LocalSessionManager/Operational</Path>
				<Expressions>
					<Expression>
						<XPath>//EventID</XPath>
						<Regex>
							<![CDATA[
								^(?<log>25)$
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>//Address</XPath>
						<Regex>
							<![CDATA[
								(?<ipaddress>.+)
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>//User</XPath>
						<Regex>
							<![CDATA[
								(?<username>[^\\\/]+)$
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>
			<Group>
				<Source>RDP</Source>
				<Keywords>0x4020000001000000</Keywords>
				<Path>Microsoft-Windows-TerminalServices-Gateway/Operational</Path>
				<Expressions>
					<Expression>
						<XPath>//EventID</XPath>
						<Regex>
							<![CDATA[
								^(?<log>200)$
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>//IpAddress</XPath>
						<Regex>
							<![CDATA[
								(?<ipaddress>.+)
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>//Username</XPath>
						<Regex>
							<![CDATA[
								(?<username>[^\\\/]+)$
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>//AuthType</XPath>
						<Regex>
							NTLM
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!-- Notify of succes SSH events -->
			<Group>
				<Source>SSH</Source>
				<Keywords>0x4000000000000000</Keywords>
				<Path>OpenSSH/Operational</Path>
				<Expressions>
					<Expression>
						<XPath>//Data[@Name='payload']</XPath>
						<Regex>
							<![CDATA[
								Accepted\s+(?:password|publickey)\s+for\s+(?<username>[^\s]+)\s+from\s+(?<ipaddress>[^\s]+)\s+port\s+[0-9]+\s+ssh
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!-- This group will notify custom ipban login success on Windows, see IPBanPlugin.cs -->
			<Group>
				<Source>IPBanCustom</Source>
				<Keywords>0x80000000000000</Keywords>
				<Path>Application</Path>
				<Expressions>
					<Expression>
						<XPath>//Data</XPath>
						<Regex>
							<![CDATA[
								(?<timestamp>\d\d\d\d-\d\d-\d\d\s\d\d:\d\d:\d\d(?:\.\d+)?Z?)?(?:,\s)?ipban\ssuccess\slogin,\sip\saddress:\s(?<ipaddress>[^,]+),\ssource:\s(?<source>[^,]+)?,\suser:\s(?<username>[^\s,]+)?
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!-- This group will notify login successes from VNC to Windows -->
			<Group>
				<Source>VNC</Source>
				<Keywords>0x80000000000000</Keywords>
				<Path>Application</Path>
				<Expressions>
					<Expression>
						<XPath>//EventID</XPath>
						<Regex>^257$</Regex>
					</Expression>
					<Expression>
						<XPath>//Data</XPath>
						<Regex>
							<![CDATA[
								Authentication\spassed\sby\s(?<ipaddress>.+)
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!-- This group will handle RRAS login successful attempt to Windows -->
			<Group>
				<Source>RRAS</Source>
				<Keywords>0x8020000000000000</Keywords>
				<Path>System</Path>
				<Expressions>
					<Expression>
						<XPath>//EventID</XPath>
						<Regex>^6272$</Regex>
					</Expression>
					<Expression>
						<XPath>//Data[@Name='SubjectUserName']</XPath>
						<Regex>
							<![CDATA[
								(?<username>[^\\\/]+)$
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>//Data[@Name='CallingStationID']</XPath>
						<Regex>
							<![CDATA[
								(?<ipaddress>.+)
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>//Data[@Name='EAPType']</XPath>
						<Regex>
							<![CDATA[
								\s?secured\spassword\s?
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

			<!-- Successful logins to mssql -->
			<Group>
				<Source>MSSQL</Source>
				<Keywords>0xa0000000000000</Keywords>
				<Path>Application</Path>
				<FailedLoginThreshold>0</FailedLoginThreshold>
				<Expressions>
					<Expression>
						<XPath>//Provider[contains(@Name,'MSSQL')]</XPath>
						<Regex></Regex>
					</Expression>
					<Expression>
						<XPath>//EventID</XPath>
						<Regex>
							<![CDATA[
								^(?<log>18454)$
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>(//Data)[1]</XPath>
						<Regex>
							<![CDATA[
				                ^(?<username>.+)$
							]]>
						</Regex>
					</Expression>
					<Expression>
						<XPath>(//Data)[2]</XPath>
						<Regex>
							<![CDATA[
								\[(CLIENTE?|클라이언트)\s?:\s?(?<ipaddress>[^\]]+)\]
							]]>
						</Regex>
					</Expression>
				</Expressions>
			</Group>

		</Groups>
	</ExpressionsToNotify>

	<appSettings>
		<!-- 모든 앱 설정값(value)에 %[환경변수명]% 형식을 사용하면 OS 환경변수 값을 직접 불러와 적용할 수 있습니다. -->

		<!--
		100% 무료 위협 인텔리전스 서비스인 IPThreat(https://ipthreat.net)에 로그인 실패 데이터를 공유하고 차단 리스트를 수신하기 위한 API 키 입력란입니다.
		사용 방법:
			IPThreat 회원가입 (https://ipthreat.net/account/signup)
			일괄 리포트 권한 요청 (https://ipthreat.net/requestpermissions)
			승인 이메일을 받은 후 API 키 생성 (https://ipthreat.net/account?tab=apikeys)
			발급받은 API 키를 아래 value=""에 입력 (서비스 재시작 불필요)
			필요 시 FirewallUriRules 설정에 IPThreat 무료 차단 리스트 URL을 등록하여 방어력 강화

			Enter your https://ipthreat.net api key here to submit failed logins to the 100% free ipthreat site and service
			1] Create an account on the ipthreat website : https://ipthreat.net/account/signup
			2] Go to https://ipthreat.net/requestpermissions to get bulk report permission
			3] Once you get an email back verifying permissions, create an api key at https://ipthreat.net/account?tab=apikeys
			4] Enter your api key below (no need to restart the service)
			5] Consume https://ipthreat.net/lists lists in the FirewallUriRules appSetting for even more protection
		-->
		<add key="IPThreatApiKey" value="" />

		<!-- 아이피 당 차단 할 실패 횟수 -->
		<add key="FailedLoginAttemptsBeforeBan" value="5"/>

		<!--
			IP 차단 유지 기간 (일:시:분:초): 00:00:00:00으로 입력 시 최대 기간인 9999일 동안 차단됩니다.
			다중 차단 시간 설정: 쉼표(,)로 구분하여 단계별로 여러 차단 시간을 지정할 수 있습니다.
			이전 차단 시간이 만료된 후 다시 차단되면 다음 단계의 (더 긴) 차단 시간이 적용됩니다.
			마지막 단계 차단까지 완료되면 DB에서 해당 IP 정보가 삭제되며, 이후 다시 차단되면 첫 번째 차단 시간부터 재시작합니다.
			주의사항: 여러 차단 시간을 지정할 때는 반드시 오름차순(점점 길어지는 순서)으로 작성해야 합니다.
		-->
		<!-- 차단 유지 기간 - 5분, 10분, 30분, 1시간, 1일, 1주일 차단 -->
		<add key="BanTime" value="00:00:05:00, 00:00:10:00, 00:00:30:00, 00:01:00:00, 01:00:00:00, 07:00:00:00"/>

		<add key="BanTimeMultiplier" value="true"/>
		<!--
			BanTime에 여러 단계의 차단 시간을 지정했을 때 동작하는 옵션 설명입니다. (단일 BanTime만 설정한 경우 이 옵션은 무시됩니다.)
			true 설정 시:
			차단 해제 후 실패 카운트가 0으로 초기화됩니다. 따라서 차단이 풀린 뒤 다시 기준 횟수(FailedLoginAttemptsBeforeBan)만큼 계속 틀려야만 다음 단계의 더 긴 차단 시간이 적용됩니다.

			false 설정 시:
			차단 해제 후에도 이전 실패 카운트가 유지됩니다. 따라서 차단이 풀린 후 단 1회만 더 틀려도 즉시 다음 단계의 더 긴 차단 시간으로 재차단됩니다.	
		-->

		<!-- 내부 IP 처리여부(차단 안함)-->
		<add key="ResetFailedLoginCountForUnbannedIPAddresses" value="false" />

		<!-- 재시작 시 전체 차단 해제 여부: IPBAN 서비스를 재시작할 때 방화벽에 등록된 모든 차단 IP를 지우고 해제할지 설정합니다. (true: 재시작 시 차단 풀림, false: 차단 유지) -->
		<add key="ClearBannedIPAddressesOnRestart" value="false"/>

		<!-- 로그인 성공 시 실패 카운트 초기화 여부: 특정 IP가 로그인에 성공하면, 그전에 쌓여있던 로그인 실패 카운트를 즉시 0으로 지울지 설정합니다. (true 권장) -->
		<add key="ClearFailedLoginsOnSuccessfulLogin" value="true"/>

		<!-- 내부 IP 처리 여부: 사설 IP 대역(192.168.x.x, 172.x.x.x 등)에서 발생한 로그인 실패도 차단 대상에 포함할지 설정합니다. (false 권장 - 관리자 IP 차단 방지) -->
		<add key="ProcessInternalIPAddresses" value="false"/>

		<!-- 실패 카운트 리셋 대기 시간: 마지막 로그인 실패 시도 후 추가 실패가 없을 때, 누적된 실패 카운트가 0으로 초기화되기까지 걸리는 시간입니다. (일:시:분:초 형식, 00:00:00:00으로 설정 시 최대 기간 적용) -->
		<add key="ExpireTime" value="01:00:00:00"/>

		<!-- 서비스가 IP 차단, 차단 해제, 설정 파일 새로고침 등의 주기적 정리 작업(House-keeping)을 수행할 간격입니다. (일.시:분:초 형식) (DD:HH:MM:SS) -->
		<add key="CycleTime" value="00:00:00:15"/>

		<!-- 특정 IP의 로그인 실패 카운트를 1회 증가시키기 위해 필요한 최소 로그인 실패 시도 간격입니다. (예: 1초로 설정 시 1초 내 연속 실패는 1회로 간주) -->
		<add key="MinimumTimeBetweenFailedLoginAttempts" value="00:00:00:01"/>

		<!-- 특정 IP의 로그인 성공 카운트를 1회 증가시키기 위해 필요한 최소 로그인 성공 시도 간격입니다. -->
		<add key="MinimumTimeBetweenSuccessfulLoginAttempts" value="00:00:00:05"/>

		<!-- 윈도우 방화벽에 등록될 규칙 이름의 접두사(Prefix)입니다. 영문 대문자(A-Z), 숫자(0-9), 언더바(_)만 사용할 수 있습니다. -->
		<add key="FirewallRulePrefix" value="IPBan_"/>

		<!--
			절대 차단되지 않는 IP 주소, CIDR 대역, URL 또는 DNS 이름의 쉼표(,) 구분 목록입니다. 화이트리스트는 블랙리스트보다 항상 우선 적용됩니다.
			URL을 지정할 경우, 응답 내용이 줄바꿈으로 구분된 텍스트 형태여야 합니다.
			URL 주소 내에 파이프(|) 문자는 허용되지 않습니다.
			이 목록에 입력된 IP는 방화벽의 화이트리스트 규칙에 등록되어 항상 접속이 허용됩니다.
		-->
		<!--내부 화이트리스트, 구분자에 쉼표다음에 띄어쓰기 금지-->
		
		<add key="Whitelist" value="11.22.33.0/24,22.33.44.0/24,22.33.44.246,33.44.55.100,44.55.66.147,55.66.77.63,1.2.3.131"/>
		<!--
			정밀한 예외 처리를 위한 고급 화이트리스트 정규표현식(Regex)입니다. Shortcut: use * to allow any piece of an ip (i.e. 128.128.128.*).
			Sample regex that whitelists a few ips: ^(128\.128\.128\..*)|(99\.99\.99\.[0-9])$
			More info about regex: http://www.regular-expressions.info/
			이 정규식은 방화벽 규칙에 직접 추가되는 것이 아니며, IP가 차단되기 직전에 이 정규식을 먼저 대조하여 일치하면 차단을 방지합니다
		-->
		<!--2026.09.26 화이트리스트가 제대로 작동 안되어서 정규식 화이트 리스트 추가-->
		<add key="WhitelistRegex" value="^(11\.22\.33\.[0-9]+|22\.33\.44\.[0-9]+|33\.44\.55\.100|44\.55\.66\.147|55\.66\.77\.63|1\.2\.3\.131)$"/>

		<!--
			Whitelist와 동일한 형식이지만, 무조건 영구 차단할 IP 목록을 지정합니다. (화이트리스트와 중복될 경우 화이트리스트가 우선함)
		-->
		<add key="Blacklist" value=""/>

		<!--
			고급 영구 차단을 위한 정규표현식입니다. Shortcut: use * to allow any piece of an ip, dns name or user name (i.e. 128.128.128.*).
			Sample regex that blacklists a few ips: ^(128\.128\.128\..*)|(99\.99\.99\.[0-9])$
			More info about regex: http://www.regular-expressions.info/    
		-->
		<add key="BlacklistRegex" value=""/>

		<!--
			로그에서 계정명을 추출할 때 지정된 문자를 기준으로 잘라냅니다. 자르지 않으려면 빈값("")으로 둡니다. 
			(예: @로 설정하면 user@domain.com을 user로만 인식하여, 여러 도메인으로 공격하는 이메일 형태 무차별 공격을 효과적으로 방어할 수 있습니다.)
		-->
		<add key="TruncateUserNameChars" value="@"/>

		<!--
			로그인 허용할 계정명 목록(쉼표 구분)입니다. 대소문자는 무시됩니다. 목록에 없는 계정명으로 로그인 실패 시 UserNameWhitelistMinimumEditDistance 값과 비교하여 즉시 차단 여부를 결정합니다.
			⚠️ 주의사항: 해커가 차단 여부를 보고 올바른 계정명에 가까워졌음을 눈치채는 공격 수단이 될 수 있습니다. 비밀번호가 충분히 복잡하다면 문제되지 않습니다.
		-->
		<add key="UserNameWhitelist" value=""/>

		<!--
			⚠️주의! 빈값이 아닐 경우, 이 정규식과 일치하지 않는 계정명으로 로그인 실패 시 단 1회만에 즉시 차단됩니다! 
			계정명 화이트리스트 정규표현식입니다. (계정명이 없는 빈 실패건도 즉시 차단됨)
		-->
		<add key="UserNameWhitelistRegex" value=""/>

		<!--
			로그인 실패한 계정명과 UserNameWhitelist의 계정명 간 텍스트 유사도(편집 거리/Levenshtein Distance) 차이가 이 값보다 크면 즉시 차단합니다. 
			UserNameWhitelist가 비어있으면 무시됩니다.
		-->
		<add key="UserNameWhitelistMinimumEditDistance" value="2" />

		<!-- 실패한 계정명이 UserNameWhitelist에 포함된 정상 계정명일 경우, IP를 차단하기까지 허용할 로그인 실패 횟수입니다. -->
		<add key="FailedLoginAttemptsBeforeBanUserNameWhitelist" value="20"/>

		<!---
			IP가 차단될 때 실행할 외부 프로세스(스크립트/프로그램)를 지정합니다.
			실행할 프로그램 파일 경로와 매개변수는 파이프(|) 문자로 구분합니다. (매개변수가 없어도 파이프 문자는 필수)
			Example: c:\files\on_ip_banned.exe|###IPADDRESS### -q
			사용 가능한 치환 변수:
			###IPADDRESS###: 차단된 IP 주소
			###USERNAME###: 로그인 시도 계정명
			###SOURCE###: 로그 출처
			###APP###: 앱 이름 및 버전
			###COUNT###: 이벤트 시도 횟수
			###LOG###: 이벤트를 유발한 로그 텍스트
			여러 스크립트를 실행하려면 줄바꿈(Enter)으로 구분하여 작성합니다.
		-->
		<add key="ProcessToRunOnBan" value=""/>

		<!---
			로그인 성공 시 실행할 외부 프로세스(스크립트)를 지정합니다. (작성 방식 및 변수는 ProcessToRunOnBan과 동일)
		-->
		<add key="ProcessToRunOnSuccessfulLogin" value=""/>

		<!---
			IP 차단이 해제될 때 실행할 외부 프로세스(스크립트)를 지정합니다. (사용 가능 변수: ###IPADDRESS###)
		-->
		<add key="ProcessToRunOnUnban" value=""/>

		<!--
			IP 주소를 허용하거나 차단하기 위해 추가할 방화벽 규칙입니다. (한 줄에 하나씩 작성)
			작성 형식: 규칙이름;allow 또는 block;IP목록(쉼표구분);포트목록(쉼표구분);플랫폼정규식
			허용(allow) 규칙: 포트 목록에 허용할 포트를 적습니다. (예: 3389)
			차단(block) 규칙: 포트 목록에 예외할(허용할) 포트를 적습니다. (예: 3389 포트만 차단하려면 0-3388,3390-65535 입력)
			포트 목록을 비워두면 모든 포트에 적용됩니다.
			규칙 이름은 16자 이하로 지정해야 합니다.
			윈도우 방화벽은 기본적으로 수신 트래픽이 차단되므로 allow 규칙 위주로 사용하며 순서는 상관없습니다 (block 규칙이 우선권을 가짐).
			See https://www.mediawiki.org/wiki/Help:Range_blocks and https://www.mediawiki.org/wiki/Help:Range_blocks/IPv6
			Negative look ahead regex: https://stackoverflow.com/questions/23724661/regex-to-negate-the-whole-word
			Put your allow rules first, then your block rules, for Linux iptables this is important, on Windows order does not matter, block rules have precedence
			On Windows firewall, all traffic is blocked by default, so only allow rules are needed, order does not matter
			On Linux iptables, all traffic is allowed by default, so allow rules are still needed but should go before any block rules
			On Linux, ipset has a bug where cidr mask /0 is not allowed, so you must split half and half of the ipv4 and ipv6 range
			Example that allows Redis from certain ip, and blocks everything except ssh, rdp, http/https:
			ReddisAllowIP;allow;10.0.0.1,10.0.0.2,192.168.1.168/24;6379;.
			WebOnly;block;0.0.0.0/1,128.0.0.0/1,::/1,8000::/1;22,80,443,3389;^(?:(?!Windows).)+$
		-->
		<add key="FirewallRules" value="

		"/>

		<!--
			차단된 IP 주소 데이터를 IPBAN 커뮤니티/서버와 공유하는 기본 핸들러를 사용할지 여부입니다. 공유하지 않으려면 false로 설정합니다.
		-->
		<add key="UseDefaultBannedIPAddressHandler" value="true" />

		<!-- 
			본 서버의 공인(외부) IP 주소를 확인하기 위해 조회할 URL 주소입니다. (기본값: https://checkip.amazonaws.com/)
		-->
		<add key="ExternalIPAddressUrl" value="https://checkip.amazonaws.com/"/>

		<!--
			외부 URL에서 위협 IP 리스트(블랙리스트 파일)를 주기적으로 다운로드하여 방화벽에 차단 등록할 수 있는 설정입니다., 
			작성 형식 (한 줄에 하나씩):
			[RulePrefix],[Interval in DD:HH:MM:SS],[URI],[MaxCount][Newline]
		-->
		<add key="FirewallUriRules" value=""/>
		<!-- Example for emerging threats
			EmergingThreats,01:00:00:00,https://rules.emergingthreats.net/fwrules/emerging-Block-IPs.txt,10000
		-->

		<!--
			서비스가 주기적 정리 작업(Cycle)을 수행할 때마다 호출(GET 요청)할 웹 URL입니다. 사용하지 않으려면 빈값으로 둡니다. (변수 연동을 통해 외부 모니터링 서버로 웹훅 전달 가능)
			Example: http://192.168.1.2/ipban/update?ip=###IPADDRESS###&amp;remoteIp=###REMOTEIPADDRESS###&amp;name=###MACHINENAME###&amp;version=###VERSION###&amp;guid=###GUID###&amp;osname=###OSNAME###&amp;osversion=###OSVERSION###
	    -->
		<add key="GetUrlUpdate" value=""/>

		<!--
			IPBAN 서비스가 시작될 때 호출(GET 요청)할 웹 URL입니다. 없으면 빈 값
			Example: http://192.168.1.2/ipban/start?ip=###IPADDRESS###&amp;remoteIp=###REMOTEIPADDRESS###&amp;name=###MACHINENAME###&amp;version=###VERSION###&amp;guid=###GUID###&amp;osname=###OSNAME###&amp;osversion=###OSVERSION###
		-->
		<add key="GetUrlStart" value=""/>

		<!--
			IPBAN 서비스가 중지될 때 호출(GET 요청)할 웹 URL입니다. 없으면 빈 값
			Example: http://192.168.1.2/ipban/stop?ip=###IPADDRESS###&amp;remoteIp=###REMOTEIPADDRESS###&amp;name=###MACHINENAME###&amp;version=###VERSION###&amp;guid=###GUID###&amp;osname=###OSNAME###&amp;osversion=###OSVERSION###
		-->
		<add key="GetUrlStop" value=""/>

		<!--
			중앙 서버나 원격 위치에서 설정 파일(ipban.config)을 동적으로 다운로드하여 적용할 때 사용하는 URL입니다.
			Example: http://192.168.1.2/ipban/config?guid=###GUID###
		-->
		<add key="GetUrlConfig" value=""/>

		<!--
			================================================================
			IPBan Pro Version Only Parameters, Ignored For Free Version
			================================================================
		-->

		<!--
			(IPBan Pro 유료 버전 전용) IPBan Pro 중앙 대시보드 서버와 웹소켓으로 통신하기 위한 URL입니다. 무료 버전에서는 동작하지 않고 무시됩니다.
			Examples: ws://localhost:52664/
		-->
		<add key="IPBanPro_UrlWebSocket" value=""/>

	</appSettings>

</configuration>